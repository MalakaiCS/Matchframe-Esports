{
  "name": "@matchframe/operator-web",
  "version": "0.1.0",
  "private": true,
  "description": "Matchframe Esports operator console (bundled into the Matchframe program) and the captain veto page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.captain.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@matchframe/contracts": "workspace:*",
    "@matchframe/hud-sdk": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
