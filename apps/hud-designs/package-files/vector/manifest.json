{
  "manifestVersion": 1,
  "id": "matchframe.vector",
  "name": "Vector HUD",
  "version": "1.1.0",
  "author": "Matchframe",
  "licence": "MIT (code, Matchframe; weapon icons, Lexogrine); fonts: SIL OFL 1.1",
  "thumbnail": "thumbnail.webp",
  "description": "Broadcast HUD with each team's players down its side of the screen: team-colour score bar with series boxes, loss bonus and series maps in freeze time, bomb and defuse bars, round winner, players alive, killfeed, observed player and radar. Panels slide, wipe and collapse with the game.",
  "game": "cs2",
  "category": "Broadcast",
  "tags": [
    "broadcast",
    "radar",
    "killfeed",
    "animated",
    "side columns"
  ],
  "schemaVersions": [
    1
  ],
  "entryPoints": {
    "live": "index.html",
    "compact": "index.html"
  },
  "designResolution": {
    "width": 1920,
    "height": 1080
  },
  "resolutions": [
    "1920x1080"
  ],
  "permissions": [
    "match.public",
    "players.public",
    "radar.public",
    "series",
    "event"
  ],
  "settingsSchema": {
    "ctColor": {
      "type": "color",
      "label": "CT colour",
      "default": "#109be3",
      "group": "Look"
    },
    "tColor": {
      "type": "color",
      "label": "T colour",
      "default": "#d05354",
      "group": "Look"
    },
    "teamNames": {
      "type": "select",
      "label": "Team names",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full name"
        },
        {
          "value": "short",
          "label": "Short (tag)"
        }
      ],
      "group": "Look"
    },
    "showRadar": {
      "type": "boolean",
      "label": "Radar",
      "default": true,
      "group": "Elements"
    },
    "showKillfeed": {
      "type": "boolean",
      "label": "Killfeed",
      "default": true,
      "group": "Elements"
    },
    "showObserved": {
      "type": "boolean",
      "label": "Observed player",
      "default": true,
      "group": "Elements"
    },
    "showAlive": {
      "type": "boolean",
      "label": "Players alive",
      "default": true,
      "group": "Elements"
    },
    "showMoney": {
      "type": "boolean",
      "label": "Player money",
      "default": true,
      "group": "Elements"
    },
    "showFreezeExtras": {
      "type": "boolean",
      "label": "Loss bonus, series and utility in freeze time",
      "default": true,
      "group": "Elements"
    }
  }
}
