{
  "name": "@matchframe/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Matchframe Esports desktop shell (Electron)",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts-build.mjs",
    "start": "electron .",
    "package:win": "electron-builder --win --config electron-builder.yml",
    "package:dir": "electron-builder --dir --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
