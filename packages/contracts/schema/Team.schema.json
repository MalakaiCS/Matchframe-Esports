{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "logoAssetId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "primaryColor": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondaryColor": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "region": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "countryCode": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "sponsorMetadata": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "archived": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "shortName"
  ]
}
