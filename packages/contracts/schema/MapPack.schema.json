                  "posY": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotationDeg": {
                    "default": 0,
                    "type": "number"
                  },
                  "imageSizePx": {
                    "default": 1024,
                    "type": "integer",
