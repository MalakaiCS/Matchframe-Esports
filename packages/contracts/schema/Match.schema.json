{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "eventId": {
      "type": [
        "string",
        "null"
      ]
    },
    "stageId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "teamAId": {
      "type": "string"
    },
    "teamBId": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "properties": {
        "bestOf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "regulationRounds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 60
        },
        "overtimeEnabled": {
          "type": "boolean"
        },
        "overtimeRounds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "allowTie": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "bestOf",
        "regulationRounds",
        "overtimeEnabled",
        "overtimeRounds"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "veto",
        "live",
        "completed",
        "cancelled"
      ]
    },
    "scheduledAt": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "seriesScoreA": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seriesScoreB": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mapPool": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vetoSequenceId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "eventId",
    "teamAId",
    "teamBId",
    "format",
    "status"
  ]
}
