{
  "manifestVersion": 1,
  "id": "test.overlay-check",
  "name": "Overlay check HUD (test fixture)",
  "version": "1.1.0",
  "author": "MatchFrame Esports",
  "licence": "MIT; weapon icons third-party MIT (third-party-licenses/); fonts: SIL OFL 1.1",
  "description": "Test fixture for scripts/overlay-check.cjs (the desktop HUD window checks on the Windows build): the former MatchFrame Sample CS2 HUD. Not shipped with the program.",
  "game": "cs2",
  "category": "Test",
  "tags": [
    "test"
  ],
  "schemaVersions": [
    1
  ],
  "entryPoints": {
    "live": "index.html",
    "compact": "index.html"
  },
  "thumbnail": "thumbnail.webp",
  "designResolution": {
    "width": 1920,
    "height": 1080
  },
  "resolutions": [
    "1920x1080"
  ],
  "permissions": [
    "event",
    "match.public",
    "players.public",
    "radar.public",
    "series"
  ],
  "settingsSchema": {
    "accentColor": {
      "type": "color",
      "label": "Accent colour",
      "default": "#2f7cf6",
      "group": "Look"
    },
    "teamNames": {
      "type": "select",
      "label": "Team names",
      "default": "short",
      "options": [
        {
          "value": "short",
          "label": "Short (tag)"
        },
        {
          "value": "full",
          "label": "Full name"
        }
      ],
      "group": "Look"
    },
    "showPlayers": {
      "type": "boolean",
      "label": "Show player lists",
      "default": true,
      "group": "Elements"
    },
    "showObserved": {
      "type": "boolean",
      "label": "Show the observed player",
      "default": true,
      "group": "Elements"
    },
    "showMinimap": {
      "type": "boolean",
      "label": "Show the minimap",
      "default": true,
      "group": "Elements"
    },
    "showKillfeed": {
      "type": "boolean",
      "label": "Show the killfeed",
      "default": true,
      "group": "Elements"
    },
    "showMoney": {
      "type": "boolean",
      "label": "Show money",
      "default": true,
      "group": "Elements"
    },
    "panelOpacity": {
      "type": "number",
      "label": "Panel opacity",
      "default": 0.86,
      "min": 0.4,
      "max": 1,
      "step": 0.02,
      "group": "Look"
    }
  }
}
