# Matchframe website + cloud API environment (docker-compose.cloud.yml --env-file).
# Copy to config/cloud.env (never commit the filled-in file) and fill in the values.

POSTGRES_PASSWORD=change-me
MF_CLOUD_PUBLIC_URL=https://app.matchframe.example

# `pnpm cloud:keygen` prints both lines below; the public half goes into config/cloud.json for desktop releases.
MF_CLOUD_SIGNING_KEY=
MF_CLOUD_EXTRA_PUBLIC_KEYS=

# Stripe (Dashboard → Developers). Leave empty to run without billing (plans shown, not purchasable).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_50=

# Email (verification, password reset, invitations). Empty keeps emails in the outbox_emails table only.
SMTP_URL=
MF_MAIL_FROM=Matchframe <no-reply@matchframe.example>

# Comma-separated staff accounts (admin pages: organisations, credits, catalogue, audit).
MF_STAFF_EMAILS=

# Desktop download shown on the website.
MF_DOWNLOAD_VERSION=0.1.0
MF_DOWNLOAD_WINDOWS_URL=
MF_DOWNLOAD_WINDOWS_SHA256=
MF_DOWNLOAD_NOTES_URL=
