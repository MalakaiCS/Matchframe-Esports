{
  "name": "matchframe-esports",
  "version": "0.1.0",
  "private": true,
  "description": "Matchframe Esports — Windows-first CS2 broadcast production manager, HUD system and intelligent observer/director.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "engine": "tsx services/local-engine/src/main.ts",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "node scripts/run-python.mjs -m pytest workers -q",
    "build": "pnpm -r run build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "schemas": "tsx packages/contracts/scripts/generate-json-schema.ts",
    "package:win": "pnpm build && pnpm --filter @matchframe/desktop run package:win",
    "package:dir": "pnpm build && pnpm --filter @matchframe/desktop run package:dir",
    "openapi": "tsx services/local-engine/scripts/generate-openapi.ts",
    "worker": "node scripts/run-python.mjs -m mf_common.cli",
    "test:integration": "vitest run services/local-engine/test/demo-pipeline.integration.test.ts packages/obs-adapter",
    "coverage:maps": "tsx services/local-engine/scripts/generate-coverage.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
